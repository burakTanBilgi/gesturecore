{
  // Type checking reads the core's source (see tsconfig.json), but a build must not:
  // pulling in .ts from outside rootDir makes tsc try to emit the core here too, which
  // is TS6059 and leaves stray .js next to the core's sources. Against the core's built
  // types instead, so this emits only its own files — which means the core must be built
  // first. `npm run build` does that: workspaces build in the order package.json lists.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "paths": { "gesturecore": ["../core/dist/index.d.ts"] }
  },
  "include": ["src"]
}
