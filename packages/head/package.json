{
  "name": "gesturecore-head",
  "version": "0.1.0",
  "description": "Optional head reader for gesturecore: face landmarks in, head turns, nods, shakes, blinks and brow raises out.",
  "keywords": ["gesturecore", "head-pose", "face", "mediapipe", "blink", "nod", "expression"],
  "homepage": "https://github.com/burakTanBilgi/gesturecore/tree/main/packages/head#readme",
  "repository": { "type": "git", "url": "git+https://github.com/burakTanBilgi/gesturecore.git", "directory": "packages/head" },
  "bugs": { "url": "https://github.com/burakTanBilgi/gesturecore/issues" },
  "author": "tanburak",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "peerDependencies": {
    "gesturecore": "^0.2.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  }
