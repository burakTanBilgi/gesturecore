{
  "name": "gesturecore",
  "version": "0.1.0",
  "description": "Turns hand-tracking landmarks into clean, debounced gesture events. No dependencies, no browser APIs.",
  "keywords": ["gesture", "hand-tracking", "mediapipe", "hand-landmarks", "pinch", "one-euro-filter", "typescript"],
  "homepage": "https://github.com/burakTanBilgi/gesturecore/tree/main/packages/core#readme",
  "repository": { "type": "git", "url": "git+https://github.com/burakTanBilgi/gesturecore.git", "directory": "packages/core" },
  "bugs": { "url": "https://github.com/burakTanBilgi/gesturecore/issues" },
  "author": "tanburak",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  }
}
