{
  "name": "gesturecore",
  "version": "0.1.0",
  "description": "Turns MediaPipe hand landmarks into clean, debounced gesture events.",
  "keywords": ["gesture", "hand-tracking", "mediapipe", "hand-landmarks", "pinch", "one-euro-filter", "typescript"],
  "homepage": "https://github.com/tanburak/gesturecore#readme",
  "repository": { "type": "git", "url": "git+https://github.com/tanburak/gesturecore.git" },
  "bugs": { "url": "https://github.com/tanburak/gesturecore/issues" },
  "author": "tanburak",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p bench/tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "bench": "vite",
    "fetch-model": "node scripts/fetch-model.mjs"
  },
  "devDependencies": {
    "@mediapipe/tasks-vision": "1.0.1",
    "dockview-core": "8.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  },
  "license": "MIT"
}
