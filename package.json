{
  "name": "gesturecore-workspace",
  "private": true,
  "description": "gesturecore and its optional bricks, plus the tuning bench.",
  "repository": { "type": "git", "url": "git+https://github.com/burakTanBilgi/gesturecore.git" },
  "author": "tanburak",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/sound"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p packages/core && tsc -p packages/sound && tsc -p bench",
    "build": "npm run build --workspaces",
    "bench": "vite",
    "fetch-model": "node scripts/fetch-model.mjs"
  },
  "devDependencies": {
    "@mediapipe/tasks-vision": "1.0.1",
    "dockview-core": "8.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
